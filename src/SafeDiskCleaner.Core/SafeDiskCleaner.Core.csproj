<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rules, guard, scan, delete and log. No UI. Ported from reference/engine.py. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SafeDiskCleaner.Core</RootNamespace>
    <AssemblyName>SafeDiskCleaner.Core</AssemblyName>
    <!-- Lets the library compile on a non-Windows machine for quick checks; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeDiskCleaner.Core.Tests" />
  </ItemGroup>

</Project>
