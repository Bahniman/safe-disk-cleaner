<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SafeDiskCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Safe Disk Cleaner">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: icon and name; the caption buttons are drawn by Windows. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarText"
                           Text="Safe Disk Cleaner"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Header: name, promise, system drive usage -->
        <Grid Grid.Row="1" Padding="24,4,24,12" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Safe Disk Cleaner" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Clears caches and leftovers. Installed tools, models and your files are never touched."
                           Style="{StaticResource MutedBodyStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Width="300" Spacing="6" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="DriveLabel" Text="C:" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="DriveText" HorizontalAlignment="Right" Style="{StaticResource BodyTextBlockStyle}" />
                </Grid>
                <ProgressBar x:Name="DriveBar" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="LastCleanedText" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
        </Grid>

        <!-- Admin state, results, notices and errors -->
        <StackPanel Grid.Row="2" Padding="24,0,24,0" Spacing="8">
            <InfoBar x:Name="AdminInfoBar" IsOpen="False" IsClosable="True" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartAdminButton"
                            Content="Restart as admin"
                            Click="RestartAsAdmin_Click"
                            AutomationProperties.Name="Restart as administrator" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ResultInfoBar" IsOpen="False" IsClosable="True" Severity="Success">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Open the log" Click="OpenLog_Click" AutomationProperties.Name="Open the log" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="NoticeInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>

        <!-- Body: groups on the left, details on the right (below on narrow windows) -->
        <Grid x:Name="BodyGrid" Grid.Row="3" Padding="24,8,24,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="DetailsRow" Height="0" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ListScroller"
                          Grid.Row="0" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
                <StackPanel x:Name="GroupsPanel" Spacing="12" Padding="0,0,0,16" />
            </ScrollViewer>

            <StackPanel x:Name="ScanningPanel"
                        Grid.Row="0" Grid.Column="0"
                        Width="360"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" />
                <TextBlock x:Name="ScanningText"
                           Text="Scanning…"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="ScanBar" Minimum="0" Maximum="1" Value="0" AutomationProperties.Name="Scan progress" />
            </StackPanel>

            <Border x:Name="DetailsPane"
                    Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailsTitle"
                               Text="Details"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsWhy"
                               Grid.Row="1"
                               Style="{StaticResource MutedBodyStyle}"
                               TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailsList" Spacing="6" Padding="0,4,12,4" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: status on the left, commands on the right -->
        <Grid Grid.Row="4" Padding="24,4,16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource MutedCaptionStyle}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="WorkBar"
                             Minimum="0" Maximum="1" Value="0"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Cleaning progress" />
            </StackPanel>
            <CommandBar Grid.Column="1"
                        DefaultLabelPosition="Right"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        OverflowButtonVisibility="Auto">
                <AppBarButton x:Name="RescanButton"
                              Label="Rescan"
                              Icon="Refresh"
                              Click="Rescan_Click"
                              AutomationProperties.Name="Rescan">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="ProtectButton"
                              Label="Protect a folder"
                              Click="Protect_Click"
                              AutomationProperties.Name="Protect a folder">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarElementContainer VerticalContentAlignment="Center" IsTabStop="False">
                    <Button x:Name="CleanButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Clean selected"
                            Margin="8,0,4,0"
                            MinWidth="160"
                            IsEnabled="False"
                            Click="Clean_Click"
                            AutomationProperties.Name="Clean selected" />
                </AppBarElementContainer>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Open the log" Click="OpenLog_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Edit protected folders (protect.txt)" Click="OpenProtectFile_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Windows storage settings" Click="StorageSettings_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
    </Grid>
</Window>
